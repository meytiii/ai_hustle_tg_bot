# Order validity window in minutes before unsubmitted orders expire
ORDER_TIMEOUT_MINUTES=120

# Path to the digital product PDF
PDF_FILE_PATH=./assets/AI_Side_Hustle.pdf

# ====================================================================
# Database Configuration
# ====================================================================
# SQLite database URL (asynchronous with WAL mode)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

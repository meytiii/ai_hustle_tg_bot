BOT_TOKEN=your_bot_token_here

# Numeric Telegram ID of the Owner (@MoHo72)
# Handles payment approval and rejection in Persian
OWNER_ID=72101760

# Numeric Telegram ID of the Developer (@mehdi_kh_278)
# Receives technical logs and sales outcome reports in English
DEVELOPER_ID=347382968

# ====================================================================
# Payment & Product Configuration
# ====================================================================
# TON Receiving Wallet Address (Non-custodial or exchange address)
TON_WALLET_ADDRESS=EQD__________________________________________

# Promotional Launch Price in USD
PRICE_USD=79.0

# Original Regular Price in USD
ORIGINAL_PRICE_USD=100.0

# Equivalent price in TON cryptocurrency
